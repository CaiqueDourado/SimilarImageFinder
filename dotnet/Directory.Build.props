<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>

    <Version>0.1.0</Version>
    <Authors>Caique Dourado</Authors>
    <Copyright>Copyright (c) 2026 Caique Dourado</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/CaiqueDourado/SimilarImageFinder</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CaiqueDourado/SimilarImageFinder</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>image;hash;perceptual-hash;phash;dhash;ahash;duplicates;near-duplicate;deduplication</PackageTags>
  </PropertyGroup>
</Project>
